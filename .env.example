OPENAI_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=

# For Deep Lead Enrichment (Feature 6)
HUNTER_API_KEY=
APOLLO_API_KEY=

# For Smart Reply Detection (Feature 3)
IMAP_SERVER=imap.gmail.com
IMAP_EMAIL=your_email@gmail.com
IMAP_PASSWORD=your_app_password

# Demo conversion layer — turns demo viewers into booked calls
BOOKING_URL=https://cal.com/your-handle/15min   # the call-booking link baked into every demo
AGENCY_NAME=Chandan Gosavi
AGENCY_WHATSAPP=                                  # digits only, e.g. 919876543210 (shows WhatsApp CTA)
AGENCY_EMAIL=your_email@gmail.com

# Email deliverability (CAN-SPAM / Gmail-Yahoo bulk rules) — keeps you out of spam
AGENCY_ADDRESS=Your Business Name, Street, City, Country   # postal address shown in email footer

# Push notifications (ntfy.sh) — alerts for hot leads, demo views, replies
NTFY_TOPIC=my-private-topic-name-123xyz   # your private ntfy.sh topic name

# CORS / tunnel — set this to your Cloudflare tunnel URL so the dashboard works remotely
LEADFLOW_PUBLIC_URL=
